# Copiar este archivo como ".env" y completar los valores reales.
# El archivo ".env" NUNCA se sube a GitHub (ver .gitignore).

# Clave secreta de Django. Generar una propia, por ejemplo con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esta-clave-por-una-generada-para-tu-proyecto

# True solo en desarrollo local. En la instancia EC2 debe quedar en False.
DEBUG=True

# Hosts permitidos, separados por coma. En EC2 agregar la IP pública o el
# DNS de la instancia, ej: 127.0.0.1,localhost,3.15.20.10
ALLOWED_HOSTS=127.0.0.1,localhost

# Motor de base de datos: "sqlite" para desarrollo local rápido,
# "mysql" para la instancia EC2 (con phpMyAdmin).
DB_ENGINE=sqlite

# Solo se usan si DB_ENGINE=mysql
DB_NAME=sgr_evaluacion
DB_USER=sgr_user
DB_PASSWORD=cambia-esta-clave
DB_HOST=localhost
DB_PORT=3306

# ---------------------------------------------------------------------------
# Correo (Evaluación 3): recuperación de contraseña por correo electrónico.
# Se usa una cuenta de Gmail como remitente, con una "contraseña de
# aplicación" de 16 caracteres (NO tu contraseña normal de Gmail).
#
# Cómo generarla:
#   1. Activa la verificación en dos pasos en tu cuenta de Google.
#   2. Ve a https://myaccount.google.com/apppasswords
#   3. Crea una nueva "contraseña de aplicación" (puedes nombrarla "SGR").
#   4. Copia el código de 16 caracteres (sin espacios) en EMAIL_HOST_PASSWORD.
# ---------------------------------------------------------------------------
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_contrasena_de_aplicacion_16_caracteres
DEFAULT_FROM_EMAIL=tu_correo@gmail.com
